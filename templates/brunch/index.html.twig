{% extends 'base.html.twig' %}


{% block title %}Nos boissons chaudes{% endblock %}
{% block stylesheets %}
    <style>
        .greyed-out {
            opacity: 0.5;
        }
    </style>
{% endblock %}
{% block body %}
<div class="container mt-5">
    <h1 class="text-center">Notre menu Brunch </h1>
    <p class="text-center">Sucré et salé parfait pour les grasses matinées du dimanche.</p>
    <div class="row">
        <!-- Boissons Chaudes -->
        <div class="col-md-4 mb-4">
            <div class="card">
                <img src="{{ asset('images/chocolatine.jpg') }}" class="card-img-top" alt="Boissons Chaudes">
                <div class="card-body">
                    <h5 class="card-title">Moscoviteries</h5>
                    <p class="card-text">Un assortiment de pains , viennoiseries et pâtisseries pour les gourmands.</p>
                    <a href="{{ path('app_cafe') }}" class="btn btn-success">En savoir plus</a>
                    </div>
                    </div>
        </div>
        <!-- Brunchs -->
        <div class="col-md-4 mb-4">
            <div class="card">
                <img src="{{ asset('images/avocado.jpg') }}" class="card-img-top" alt="Brunchs">
                <div class="card-body">
                    <h5 class="card-title">Fruits en jus et salades</h5>
                    <p class="card-text">Des vitamines afin de survivre au Grand Père Hiver.</p>
                    <a href="" class="btn btn-success">En savoir plus</a>
                    </div>
                    </div>
                    </div>
        <!-- Goûners -->  
        <div class="col-md-4 mb-4">
            <div class="card">
                <img src="{{ asset('images/muesli.jpg') }}" class="card-img-top" alt="Goûners">
                <div class="card-body">
                    <h5 class="card-title">Céréales</h5>
                    <p class="card-text">Pour reprendre des forces.</p>
                    <a href="" class="btn btn-success">En savoir plus</a>
                    </div>
                    </div>

    </div>
</div>
{% endblock %}
