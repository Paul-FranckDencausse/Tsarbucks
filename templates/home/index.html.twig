{% extends 'base.html.twig' %}
{% block stylesheets %}
    <style>
      .overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5); /* Semi-transparent black overlay */
        z-index: 1;
    }

    .container {
        z-index: 2;
    }
    </style>
{% endblock %}
{% block title %}Accueil - Tsarbucks{% endblock %}

{% block body %}

<header class="text-center text-white py-5" style="background-image: url('images/devanture.jpg'); background-size: cover; background-position: center; min-height: 400px; position: relative;">
    <div class="overlay"></div>
    <div class="container position-relative">
        <h1 class="display-4">Bienvenue chez TsarBucks</h1>
        <p class="lead">Découvrez les meilleurs salons de cafés près de chez vous</p>
    </div>
</header>


<section class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-5 text-success fw-bold" style="letter-spacing: 1px;">Le Concept Tsarbucks</h2>
        <div class="row align-items-center">
            <!-- Image Section -->
            <div class="col-md-6 mb-4 mb-md-0">
                <img src="{{ asset('images/toulouse.jpg') }}" class="img-fluid rounded shadow" alt="Café Tsarbucks">
            </div>
            <!-- Text and Buttons Section -->
            <div class="col-md-6">
                <div class="mb-4 text-center">
                    <p class="lead">
                        <strong>Bienvenue chez TsarBucks !</strong><br>
                        Toute ressemblance avec une marque américaine de salons de cafés est purement fortuite.
                    </p>
                    <a href="{{ path('app_salons') }}" class="btn btn-success btn-lg text-white shadow-sm">
                        <i class="fas fa-coffee"></i> Voir les Salons
                    </a>
                </div>
                <div class="mb-4 text-center">
                    <p class="lead">
                        L'âme de Tsarbucks, c'est un <strong>humour décalé</strong> et des <strong>activités conviviales</strong>.
                    </p>
                    <a href="{{ path('app_activites') }}" class="btn btn-info btn-lg text-white shadow-sm">
                        <i class="fas fa-users"></i> Voir les Activités
                    </a>
                </div>
                <div class="text-center">
                    <p class="lead">
                        Notre menu est un véritable <strong>voyage culinaire</strong> dans un esprit bon enfant.
                    </p>
                    <a href="{{ path('app_menu_index') }}" class="btn btn-success btn-lg text-white shadow-sm">
                        <i class="fas fa-utensils"></i> Voir le Menu
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <h2 class="text-center mb-4">Témoignages</h2>
        <div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <blockquote class="blockquote text-center">
                        <p class="mb-0">"Le meilleur café de l'empire ! On se sent comme un Tsar dans son palais."</p>
                        <footer class="blockquote-footer mt-3">Tsar Pierre le Grand</footer>
                    </blockquote>
                </div>
                <div class="carousel-item">
                    <blockquote class="blockquote text-center">
                        <p class="mb-0">"Ambiance royale et café impérial, un vrai festin pour les sens !"</p>
                        <footer class="blockquote-footer mt-3">Tsarina Alexandra</footer>
                    </blockquote>
                </div>
                <div class="carousel-item">
                    <blockquote class="blockquote text-center">
                        <p class="mb-0">"Des boissons dignes d'une cour impériale et un service royal !"</p>
                        <footer class="blockquote-footer mt-3">Tsar Nicolas II</footer>
                    </blockquote>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="">Next</span>
            </button>
            <ol class="carousel-indicators">
                <li data-bs-target="#testimonialCarousel" data-bs-slide-to="0" class="active"></li>
                <li data-bs-target="#testimonialCarousel" data-bs-slide-to="1"></li>
                <li data-bs-target="#testimonialCarousel" data-bs-slide-to="2"></li>
            </ol>
        </div>
    </div>
</section>

<div class="modal fade" id="cookieModal" tabindex="-1" aria-labelledby="cookieModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cookieModalLabel">Un peu de cookies ? 🍪</h5>
            </div>
            <div class="modal-body text-center">
                <p>
                    Camarade, nous avons besoin de tes cookies pour alimenter la révolution du café !<br>
                    Promis, pas d'espionnage, juste du bon café et des statistiques anonymes.
                </p>
                <p>
                     Ce project est une création fictive réalisée dans le cadre du bachelor et titre professionnel de concepteur/développeur d'applications web chez My Digital School Bordeaux par Paul-Franck Dencausse.
                  Tsarbucks s'inspire librement de l'histoire de la russie Tsariste et Soviétique jusqu'à la chute du mur de Berlin. Ce n'est en aucun cas une apologie de ces régimes politiques ou de l'actuel. 
                  J'espère que vous saurez apprécier ce projet pas très orthodoxe, ni très catholique sans protester  
                </p>
                <img src="https://media.giphy.com/media/l4FGuhL4U2WyjdkaY/giphy.gif" alt="Cookie gif" class="img-fluid rounded">
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-primary" id="acceptCookies">D'accord, pour la Tsarbuckocratie !</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Non, je préfère rester sans café...</button>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascript %}

<script>
document.addEventListener('DOMContentLoaded', () => {
    const cookieModal = new bootstrap.Modal(document.getElementById('cookieModal'), {
        backdrop: 'static',
        keyboard: false
    });
    const acceptButton = document.getElementById('acceptCookies');

    // Vérifie si le cookie existe
    const isCookieAccepted = document.cookie.split('; ').find(row => row.startsWith('cookieConsent='));

    // Affiche le modal si le cookie n'est pas défini
    if (!isCookieAccepted) {
        cookieModal.show();
    }

    // Gestion du clic sur le bouton
    acceptButton.addEventListener('click', () => {
        document.cookie = "cookieConsent=true; path=/; max-age=" + 60 * 60 * 24 * 365; // 1 an
        alert('Merci, camarade ! Ta contribution sera gravée dans l’histoire du café impérial.');
        cookieModal.hide();
    });
});
</script>

{% endblock %}

