{% extends 'base.html.twig' %}

{% block title %}Notre Menu{% endblock %}
{% block stylesheets %}
    <style>
        .greyed-out {
            opacity: 0.5;
        }
    </style>
{% endblock %}
{% block body %}
<div class="container mt-5">
    <h1 class="text-center">Notre Menu</h1>
    <p class="text-center">Découvrez notre menu de boissons chaudes, brunchs et "goûners"(goûter + diner).</p>
     <div class="row">
        {% for item in menus %}
            {% if item.type == 'Spécialité locale' %}
                <div class="col-md-4 mb-4">
                    <div class="card shadow">
                       <img src="{{ asset('uploads/media/' ~ item.imageFilename) ?: asset('images/default.png') }}"
                        class="card-img-top" alt="{{ item.name }}">

                        <div class="card-body">
                            <h5 class="card-title text-primary">{{ item.name }}</h5>
                            <p class="card-text">{{ item.description }}</p>
                            <p class="card-text"><strong>Prix : </strong>{{ item.price }} €</p>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
    <div class="row">
        {% for item in menus %}
            {% if item.type == 'Café' %}
                <div class="col-md-4 mb-4">
