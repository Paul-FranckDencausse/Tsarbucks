{% extends 'base.html.twig' %}


{% block title %}Nos boissons chaudes{% endblock %}
{% block stylesheets %}
    <style>
        .greyed-out {
            opacity: 0.5;
        }
    </style>
{% endblock %}
{% block body %}
<div class="container mt-5">
    <h1 class="text-center">Notre menu "Goûner" </h1>
    <p class="text-center">Salé et sucré  , parfait pour casser la croûte après les cours.</p>
    <div class="row">
 
        <div class="col-md-4 mb-4">
            <div class="card">
                <img src="{{ asset('images/pirozhki.jpg') }}" class="card-img-top" alt="Boissons Chaudes">
                <div class="card-body">
                    <h5 class="card-title">A manger sur le pouce</h5>
                    <p class="card-text">Sur place ou à emporter.</p>
                    <a href="{{ path('app_cafe') }}" class="btn btn-success">En savoir plus</a>
                    </div>
                    </div>
        </div>
     
        <div class="col-md-4 mb-4">
            <div class="card">
                <img src="{{ asset('images/napoleon.jpg') }}" class="card-img-top" alt="Brunchs">
                <div class="card-body">
                    <h5 class="card-title">A goûter absolument!</h5>
                    <p class="card-text">Pâtisseries et autres délicatesses.</p>
                    <a href="" class="btn btn-success">En savoir plus</a>
                    </div>
                    </div>
                    </div>

        <div class="col-md-4 mb-4">
            <div class="card">
                <img src="{{ asset('images/matrioshka.jpg') }}" class="card-img-top" alt="Goûners">
                <div class="card-body">
                    <h5 class="card-title">Apéro-tapas et dips</h5>
                    <p class="card-text">Venez donc vous asseoir et passez un bon moment entre amis.</p>
                    <a href="" class="btn btn-success">En savoir plus</a>
                    </div>
                    </div>

    </div>
</div>
{% endblock %}
